import 'dart:io';
import 'dart:ui' as ui;

import 'package:aonw/game/domain/game_state.dart';
import 'package:aonw/game/application/ports/save_snapshot.dart';
import 'package:aonw_core/domain.dart';
import 'package:flutter/material.dart';
import 'package:flutter/rendering.dart';
import 'package:flutter/services.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:shared_preferences/shared_preferences.dart';

import 'game/support/game_hud_external_fixtures.dart';
import 'game/support/game_hud_shared_fixtures.dart';

void main() {
  TestWidgetsFlutterBinding.ensureInitialized();
  setUpAll(() async {
    await (FontLoader('Cinzel')..addFont(rootBundle.load('assets/fonts/Cinzel-VariableFont_wght.ttf'))).load();
    await (FontLoader('Lato')..addFont(rootBundle.load('assets/fonts/Lato-Regular.ttf'))).load();
    await (FontLoader('MaterialIcons')..addFont(rootBundle.load('fonts/MaterialIcons-Regular.otf'))).load();
  });
  for (final sample in [
    (name: 'phone', size: const Size(390, 844)),
    (name: 'tablet', size: const Size(1024, 768)),
    (name: 'desktop', size: const Size(1440, 900)),
  ]) {
    for (final panel in ['hud', 'objectives', 'research', 'empire', 'activityLog']) {
      testWidgets('${sample.name} $panel reference', (tester) async {
        SharedPreferences.setMockInitialValues({});
        tester.view.devicePixelRatio = 1;
        tester.view.physicalSize = sample.size;
        addTearDown(tester.view.resetPhysicalSize);
        addTearDown(tester.view.resetDevicePixelRatio);
        await tester.binding.setSurfaceSize(sample.size);
        addTearDown(() => tester.binding.setSurfaceSize(null));
        final repository = FakeHudRepository(
          snapshot: GameSnapshotFactory.fromClientState(
            save: hudSave,
            state: GameClientState(activePlayerId: 'player_1'),
          ),
        );
        await const PumpGameHudTest()(tester,
          repository: repository,
          autoActionFlowEnabled: false,
          autoTurnFlowEnabled: false,
        );
        await tester.pump();
        await tester.pump(const Duration(milliseconds: 500));
        if (panel != 'hud') {
          await tester.tap(find.byKey(Key('globalHud.action.$panel')));
          await tester.pump();
          await tester.pump(const Duration(milliseconds: 500));
        }
        expect(MediaQuery.sizeOf(tester.element(find.byType(Scaffold).first)), sample.size);
        final boundary = tester.firstRenderObject<RenderRepaintBoundary>(find.byType(RepaintBoundary));
        await tester.runAsync(() async {
          final image = await boundary.toImage();
          final bytes = await image.toByteData(format: ui.ImageByteFormat.png);
          const output = String.fromEnvironment('AONW_REFERENCE_OUTPUT', defaultValue: '/tmp/aonw-parity-reference');
          final file = File('$output/${sample.name}_$panel.png');
          file.parent.createSync(recursive: true);
          file.writeAsBytesSync(bytes!.buffer.asUint8List());
          image.dispose();
        });
        await tester.pumpWidget(const SizedBox.shrink());
        await tester.pump();
        expect(tester.takeException(), isNull);
      });
    }
  }
}
