{$AONW_API_HOST} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	@serverpodWeb path /auth/* /api/stats
	reverse_proxy @serverpodWeb {$AONW_WEB_UPSTREAM} {
		header_up -Forwarded
		header_up -CF-Connecting-IP
		header_up X-Forwarded-For {client_ip}
	}

	reverse_proxy {$AONW_UPSTREAM} {
		header_up -Forwarded
		header_up -CF-Connecting-IP
		header_up X-Forwarded-For {client_ip}
	}
}

{$AONW_HOMEPAGE_HOST} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	@homepageHtml {
		path / /index.html /privacy-policy /privacy-policy/ /privacy-policy/index.html /architecture /architecture/ /architecture/index.html /stats /stats/ /stats/index.html
	}
	header @homepageHtml {
		Cache-Control "no-cache, must-revalidate"
		Content-Type "text/html; charset=utf-8"
	}

	@homepageDownloads {
		path /download/*
	}
	header @homepageDownloads {
		Cache-Control "public, max-age=0, s-maxage=3600, must-revalidate"
		Cloudflare-CDN-Cache-Control "public, max-age=3600"
	}

	redir /privacy-policy/ /privacy-policy 308
	redir /architecture/ /architecture 308
	redir /architecture/index.html /architecture 308
	redir /stats/ /stats 308

	@homepageStatsApi path /api/stats
	handle @homepageStatsApi {
		reverse_proxy {$AONW_WEB_UPSTREAM} {
			header_up -Forwarded
			header_up -CF-Connecting-IP
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		header {
			?Cache-Control "public, max-age=86400"
		}
		root * /srv/homepage
		try_files {path} {path}/index.html
		file_server
	}
}

{$AONW_ENGINE_DOCS_HOST} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}

	@engineDocsHtml path / /index.html /architecture /architecture/ /architecture/index.html /*.html
	header @engineDocsHtml {
		Cache-Control "no-cache, must-revalidate"
	}

	redir /architecture/ /architecture 308
	redir /architecture/index.html /architecture 308

	@engineDocsStatic path /static.files/*
	header @engineDocsStatic {
		Cache-Control "public, max-age=31536000, immutable"
	}

	handle {
		header {
			?Cache-Control "public, max-age=300, must-revalidate"
		}
		root * /srv/engine-docs
		try_files {path} {path}/index.html
		file_server
	}
}

{$AONW_DEMO_HOST} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	@demoRuntime {
		path / /index.html /flutter_bootstrap.js /flutter.js /flutter_service_worker.js /main.dart.js /main.dart.mjs /main.dart.wasm /version.json /manifest.json
	}
	header @demoRuntime {
		Cache-Control "no-cache, must-revalidate"
		Cloudflare-CDN-Cache-Control "no-cache"
	}

	@demoAssets {
		path /assets/* /canvaskit/* /icons/*
	}
	header @demoAssets {
		Cache-Control "public, max-age=3600, must-revalidate"
		Cloudflare-CDN-Cache-Control "public, max-age=3600"
	}

	root * /srv/demo
	try_files {path} /index.html
	file_server
}
