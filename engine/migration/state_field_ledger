# AoNW current state and envelope field ledger.
#
# This is one greenfield current rule-state contract. Internal schema and
# behavior counters are absent. API versions remain on independently consumed
# multi-component boundaries; the Dart snapshot version is a legacy-source fact.
#
# Format:
#   expected-fixture-count <integer>
#   expected-envelope-count <integer>
#   expected-envelope-field-count <integer>
#   expected-domain-field-count <integer>
#   expected-state-json-key-count <integer>
#   expected-lifecycle-json-key-count <integer>
#   fixture-root <repo-relative-path>
#   dart-domain-state-source <repo-relative-path>
#   dart-domain-codec-source <repo-relative-path>
#   dart-snapshot-source <repo-relative-path>
#   dart-metadata-source <repo-relative-path>
#   rust-state-dto-source <repo-relative-path>
#   rust-save-source <repo-relative-path>
#   rust-client-response-source <repo-relative-path>
#   envelope <id> <boundary> <type> <source> <status>
#   envelope-field <envelope-id> <field> <ownership>
#   domain-field <DartField> <section> <status> <RustGameStateDtoField-or-dash>
#   state-json-key <key> <section> <required|conditional> <domain-owner>
#   lifecycle-json-key <key> <section> <conditional> <domain-owner>
#
# `reference-only` means the Rust canonical state cannot represent the field.
# `characterized` means a related Rust field exists, but the current typed
# canonical round-trip has not been demonstrated. `state-contract-ready` means
# the field has strict DTO/domain representation, canonical normalization and
# digest participation without opaque JSON preservation; it does not claim
# functional engine parity for commands that mutate the field.

