{
  "tool": {
    "name": "cargo-llvm-cov",
    "version": "0.9.0",
    "source": "https://crates.io/crates/cargo-llvm-cov/0.9.0"
  },
  "groups": {
    "authoritative": [
      "aonw_ai",
      "aonw_content",
      "aonw_contract_mapping",
      "aonw_contracts",
      "aonw_domain",
      "aonw_engine",
      "aonw_projection"
    ],
    "runtime": [
      "aonw_local_runtime",
      "aonw_server_runtime"
    ],
    "adapters": [
      "aonw_flutter",
      "aonw_godot",
      "aonw_server_native"
    ],
    "authoring": [
      "aonw_map_authoring",
      "aonw_map_compiler",
      "aonw_map_compiler_cli",
      "aonw_map_workbench"
    ],
    "testkit": [
      "aonw_testkit"
    ]
  },
  "instrumentedGroups": [
    "authoritative",
    "runtime"
  ],
  "permittedDependencyCoverageGroups": [
    "testkit"
  ],
  "methodology": {
    "primaryMetric": "line",
    "changedLines": "enforced-by-full-crate-ratchets",
    "branchCoverage": "diagnostic-until-stable-source-mapping",
    "renames": "explicit-reviewed-baseline-update",
    "macros": "llvm-source-attribution",
    "generatedTestSupport": "excluded-only-by-reviewed-globs",
    "smallCrates": "same-per-crate-ratchets"
  },
  "sourceRoot": "src",
  "exclusions": {
    "testAndSupport": [
      "**/tests.rs",
      "**/tests/**"
    ],
    "generated": [],
    "platform": []
  }
}
